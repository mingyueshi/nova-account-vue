{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["vite/client", "node"],
    "resolveJsonModule": true, "isolatedModules": true, "noEmit": true, "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "demo/**/*.ts", "demo/**/*.vue", "tests/**/*.ts", "vite*.ts"],
  "exclude": ["node_modules", "dist", "examples"]
}
